# This image extracts the macOS SDK + the Xcode Developer tree from the
# operator-provided Xcode_${XCODE_SDKV}.xip via extract_xcode_sdks.sh, writing
# the resulting tarballs into /root/files (bind-mounted to containers/files at
# build time). The osx/ios images then consume those tarballs.
ARG IMAGE_VERSION=latest

FROM godot-fedora:${IMAGE_VERSION}

ARG IMAGE_VERSION
ARG REPO_URL="https://github.com/nongvantinh/godot-build-scripts"

LABEL "org.opencontainers.image.source"="$REPO_URL"

# Copy the necessary files into the image (the xip + extract_xcode_sdks.sh).
COPY files /root/files

RUN dnf -y install --setopt=install_weak_deps=False \
      clang xar xar-devel xz-devel cpio && \
    git clone --progress https://github.com/nrosenstein-stuff/pbzx && \
    cd pbzx && \
    git checkout bf536e167f2e514866f91d7baa0df1dff5a13711 && \
    clang -O3 -llzma -lxar -I /usr/local/include pbzx.c -o pbzx

# Xcode 26.1.1 ships the macOS 26.1 SDK. Parameterised at image-build time:
# build-godot.py's container_builder passes --build-arg XCODE_SDKV / APPLE_SDKV
# from [build].xcode_sdkv / [build].apple_sdkv so the version strings are not
# hand-edited per Xcode bump. The defaults below keep a standalone
# `docker build` working when the build-args are omitted.
ARG XCODE_SDKV
ARG APPLE_SDKV
ENV XCODE_SDKV=${XCODE_SDKV:-26.1.1}
ENV APPLE_SDKV=${APPLE_SDKV:-26.1}

# extract_xcode_sdks.sh unpacks Xcode_${XCODE_SDKV}.xip and packs
# MacOSX${APPLE_SDKV}.sdk.tar.xz + Xcode-Developer${XCODE_SDKV}.tar.xz into
# /root/files. The iPhoneOS SDK is shipped inside the Developer tree, so it is
# not packed separately (matches upstream).
CMD ["/root/files/extract_xcode_sdks.sh"]
